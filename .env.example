# ==========================================
# Arkan Game - Production Environment Configuration
# Copy this file to .env and fill in secure values before deploying
# ==========================================

# Environment Mode (production / development)
ENVIRONMENT=production

# Security & Authentication
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_character_key

# PostgreSQL Credentials
POSTGRES_USER=arkan_user
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=arkan_db

# MinIO Object Storage Credentials
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_to_a_secure_minio_password

# Redis Storage
REDIS_URL=redis://redis:6379/0

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=https://mini.arsaku.web.id,http://localhost:3000,http://localhost:8080

# AI Services
GEMINI_API_KEY=

# Seed default test account (parent@arkan.com / arkan123)
# Set to 'true' ONLY in development environment
SEED_DEFAULT_DATA=false

# Cloudflare Tunnel Token
CLOUDFLARED_TUNNEL_TOKEN=your_cloudflared_tunnel_token_here

